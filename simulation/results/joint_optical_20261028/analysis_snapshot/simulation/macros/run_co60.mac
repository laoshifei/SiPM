# Run from the SiPM project root. Keep this output path new for every run.
/control/verbose 1
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/csi/config simulation/configs/csi_tl_initial.json
/csi/source Co60
/csi/seed 280060
/csi/output simulation/results/macro_co60/events.root
/run/initialize
/run/beamOn 100
